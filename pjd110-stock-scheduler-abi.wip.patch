diff --git a/kernel/sched/build_policy.c b/kernel/sched/build_policy.c
index 005025f..9dea46c 100644
--- a/kernel/sched/build_policy.c
+++ b/kernel/sched/build_policy.c
@@ -36,6 +36,21 @@
 #include "sched.h"
 #include "smp.h"
 
+#ifdef CONFIG_SLIM_SCHED
+/* Layouts measured from PJD110_16.0.8.300 stock BTF. */
+static_assert(sizeof(struct task_struct) == 4800);
+static_assert(offsetof(struct task_struct, scx) == 3608);
+static_assert(sizeof(struct sched_ext_entity) == 264);
+static_assert(offsetof(struct sched_ext_entity, sched_prop) == 168);
+static_assert(offsetof(struct sched_ext_entity, top_task_prop) == 176);
+static_assert(offsetof(struct sched_ext_entity, sts) == 184);
+static_assert(offsetof(struct sched_ext_entity, running_at) == 248);
+static_assert(offsetof(struct sched_ext_entity, gdsq_idx) == 256);
+static_assert(offsetof(struct sched_ext_entity, dsq_sync_ux) == 260);
+static_assert(sizeof(struct scx_dispatch_q) == 96);
+static_assert(sizeof(struct rq) == 3840);
+#endif
+
 #include "autogroup.h"
 #include "stats.h"
 #include "pelt.h"
